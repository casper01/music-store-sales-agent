# Google Gemini configuration. Copy to .env and fill in LLM_API_KEY:
#   cp .env.gemini.example .env
# Never commit .env (it is in .gitignore).

# --- Required -------------------------------------------------------------------------------
# Free API key from https://aistudio.google.com/api-keys
LLM_API_KEY=

# --- Model and provider (Gemini's OpenAI-compatible endpoint) ---------------------------------
# After changing EMBEDDING_MODEL, rebuild the index: sales-agent index
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
# Leave empty to use the model's default.
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=90
# The free tier allows only a few requests per minute; the SDK retries HTTP 429 with backoff.
LLM_MAX_RETRIES=6

# --- Paths (relative to the directory you run the CLI from) ---------------------------------
DATABASE_PATH=data/Chinook_Sqlite.sqlite
KNOWLEDGE_PATH=knowledge
VECTOR_STORE_PATH=.vector_store

# --- Limits -----------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=8
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=5
KNOWLEDGE_TOP_K=4
MAX_TOOL_OUTPUT_CHARS=20000
