# OpenAI configuration. Copy to .env and fill in LLM_API_KEY:
#   cp .env.openai.example .env
# Never commit .env (it is in .gitignore).

# --- Required -------------------------------------------------------------------------------
# API key from https://platform.openai.com/api-keys
LLM_API_KEY=

# --- Model and provider -----------------------------------------------------------------------
# After changing EMBEDDING_MODEL, rebuild the index: sales-agent index
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Leave empty to use the model's default; 0-0.2 gives more repeatable answers.
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# Retries with backoff on HTTP 429 (rate limits).
LLM_MAX_RETRIES=4

# --- Paths (relative to the directory you run the CLI from) ---------------------------------
DATABASE_PATH=data/Chinook_Sqlite.sqlite
KNOWLEDGE_PATH=knowledge
VECTOR_STORE_PATH=.vector_store

# --- Limits -----------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=8
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=5
KNOWLEDGE_TOP_K=4
MAX_TOOL_OUTPUT_CHARS=20000
